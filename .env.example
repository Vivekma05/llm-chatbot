# Copy this file to .env and fill in your key. .env is git-ignored.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash

# Context window management
CONTEXT_STRATEGY=summarize   # summarize | truncate
MAX_MESSAGES=12              # compact history once it exceeds this
KEEP_RECENT=6                # messages always sent verbatim
REQUEST_TIMEOUT_S=30
